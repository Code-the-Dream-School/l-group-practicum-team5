PORT=5000

# PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/mydb

# Authentication
JWT_SECRET=replace_with_a_strong_random_secret
JWT_LIFETIME=1d
AUTH_COOKIE_NAME=gatherly_auth

# Frontend origin allowed to send credentialed requests.
# Use a comma-separated list when multiple origins are needed.
CORS_ORIGIN=http://localhost:5173

# Cookie settings for local development. For cross-site production deployments,
# set COOKIE_SECURE=true and COOKIE_SAMESITE=none.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
